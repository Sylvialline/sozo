{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "运行当前题解（CPython）",
      "type": "process",
      "command": "python",
      "args": [
        "-u",
        "${file}"
      ],
      "options": {
        "cwd": "${fileDirname}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "PyPy：直接运行当前脚本",
      "type": "process",
      "command": "python",
      "args": [
        "${workspaceFolder}/workflow/run_python.py",
        "pypy",
        "${file}"
      ],
      "problemMatcher": []
    }
  ]
}
